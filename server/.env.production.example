# Copy to server/.env on the deployment host and replace every REPLACE_* value.
POSTGRES_DB=courthelper
POSTGRES_USER=courthelper
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
DATABASE_URL=

CREDENTIAL_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
CORS_EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_FIXED_EXTENSION_ID
CORS_ADMIN_ORIGINS=https://court.hyhbrand.xyz

# Optional enterprise WeChat group robot. Never commit the real webhook key.
WECOM_WEBHOOK_URL=

LOCAL_STORAGE_DIR=/var/lib/court-helper/storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_ACCESS_KEY_SECRET=

PORT=3000
SESSION_TTL_SECONDS=28800
EXTENSION_SESSION_TTL_SECONDS=2592000
LOCAL_LOGIN_HELPER_AUTOSTART=false

# Encrypted backup destination. The age private key stays in the customer password vault.
BACKUP_AGE_RECIPIENT=REPLACE_WITH_AGE_PUBLIC_RECIPIENT
COS_BACKUP_URI=cos://REPLACE_WITH_PRIVATE_BUCKET/court-helper
