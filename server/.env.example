# Copy this file to .env before starting Compose. Replace all REPLACE_* values.

# Built-in PostgreSQL is used when DATABASE_URL is blank.
POSTGRES_DB=courthelper
POSTGRES_USER=courthelper
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD

# Optional: leave blank for the built-in db service; set an external URL to upgrade.
DATABASE_URL=

# Required application secrets and origins.
CREDENTIAL_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
CORS_EXTENSION_ORIGINS=chrome-extension://REPLACE_WITH_EXTENSION_ID
CORS_ADMIN_ORIGINS=

# Optional enterprise WeChat group robot. Keep the real key only in this private .env file.
WECOM_WEBHOOK_URL=

# Default local storage path. Leave blank or remove this line when using external COS/OSS.
LOCAL_STORAGE_DIR=/var/lib/court-helper/storage

# Optional external COS/OSS upgrade. Leave blank while LOCAL_STORAGE_DIR is set.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_ACCESS_KEY_SECRET=

PORT=3000
SESSION_TTL_SECONDS=28800
