{
  "name": "court-helper",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "法院立案/强执查询助手 Edge 插件（MV3）",
  "scripts": {
    "test": "node --test --test-concurrency=2",
    "server:build": "tsc -p server/tsconfig.json",
    "server:migrate": "npm run server:build && node server/dist/migrate.js",
    "server:start": "node server/dist/main.js",
    "fixture": "python scripts/generate-fixtures.py",
    "build": "node ./scripts/build-extension.mjs",
    "release": "node ./scripts/release-package.mjs",
    "release:windows-local": "node ./scripts/windows-local-release.mjs",
    "release:windows-local:staging": "node ./scripts/windows-local-release.mjs --staging-only"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "argon2": "^0.45.1",
    "fastify": "^5.11.2",
    "html2canvas": "^1.4.1",
    "exceljs": "^4.4.0",
    "pg": "^8.22.0",
    "pg-mem": "^3.0.14"
  }
}
