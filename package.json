{
  "name": "court-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "法院立案/强执查询助手 Edge 插件（MV3）",
  "scripts": {
    "test": "node --test",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node server/dist/main.js",
    "fixture": "python scripts/generate-fixtures.py",
    "build": "esbuild extension/popup/popup.js --bundle --format=esm --outfile=extension/dist/popup.bundle.js && esbuild extension/content/court-content.js --bundle --format=iife --outfile=extension/dist/court-content.bundle.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "esbuild": "^0.28.1",
    "exceljs": "^4.4.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "argon2": "^0.45.1",
    "fastify": "^5.11.2",
    "html2canvas": "^1.4.1",
    "pg": "^8.22.0",
    "pg-mem": "^3.0.14"
  }
}
